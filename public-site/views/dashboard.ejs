<%- include('partials/head', { title: 'Dashboard' }) %>
<div class="phone">
  <%- include('partials/header', { user, settings }) %>
  <main class="main">
    <% if (!user.is_active) { %>
      <div class="active-banner">
        <i class="fa-solid fa-triangle-exclamation banner-alert"></i>
        <h3>আপনার একাউন্ট একটিভ নয়!</h3>
        <p>আপনার একাউন্ট এ্যাক্টিভ করে <%= settings.activation_bonus %> টাকা বোনাস নিন সাথে সাথে 💸</p>
        <a href="<%= settings.activation_link %>" target="_blank" rel="noopener" class="pill-btn"><i class="fa-solid fa-bolt"></i> Active Now</a>
      </div>
    <% } %>

    <div class="card timer-card">
      <div class="timer-head">
        <span class="timer-title"><i class="fa-solid fa-clock"></i> সাইটের বয়স</span>
        <span class="live-badge"><span class="live-dot"></span> Live</span>
      </div>
      <div class="timer-grid" id="siteTimer" data-start="<%= settings.site_start %>">
        <div class="t-box"><b data-d>0</b><span>দিন</span></div>
        <div class="t-box"><b data-h>0</b><span>ঘণ্টা</span></div>
        <div class="t-box"><b data-m>0</b><span>মিনিট</span></div>
        <div class="t-box"><b data-s>0</b><span>সেকেন্ড</span></div>
      </div>
    </div>

    <% if (notices.length) { %>
      <div class="notice-bar">
        <span class="notice-chip">Notice</span>
        <div class="marquee"><span><%= notices.map(n => n.text).join('  •  ') %></span></div>
      </div>
    <% } %>

    <div class="card projects-card">
      <div class="proj-head"><i class="fa-solid fa-rocket"></i> আমাদের প্রজেক্ট সমূহ</div>
      <div class="grid4">
        <% tasks.forEach(t => { %>
          <a href="<%= t.kind === 'page' ? '/' + t.page : '/task/' + t.id %>" class="proj">
            <div class="ico" style="color:<%= t.color %>">
              <i class="<%= t.icon %>"></i>
              <% if (t.locked) { %><span class="lock"><i class="fa-solid fa-lock"></i></span><% } %>
            </div>
            <span class="proj-name"><%= t.name_bn %></span>
          </a>
        <% }); %>
      </div>
    </div>
  </main>
  <%- include('partials/bottomnav', { nav: 'home' }) %>
</div>
<%- include('partials/drawer', { user, settings, nav: 'home' }) %>
<%- include('partials/flash') %>
<% if (welcome) { %><%- include('partials/welcome-modal', { settings }) %><% } %>
<script src="/app.js"></script>
</body>
</html>

<%- include('partials/head', { title: 'Account Settings' }) %>
<div class="phone">
  <%- include('partials/header', { user, settings }) %>
  <main class="main">
    <div class="profile-banner">
      <div class="profile-avatar">
        <i class="fa-solid fa-user-tie"></i>
        <span class="cam"><i class="fa-solid fa-camera"></i></span>
      </div>
      <h3 class="profile-title">Account Settings</h3>
    </div>

    <form method="post" action="/profile" class="card profile-form">
      <label class="fld-label">Full Name</label>
      <input type="text" name="full_name" value="<%= user.full_name %>" required>

      <label class="fld-label">Email Address</label>
      <input type="email" value="<%= user.email %>" disabled class="disabled">
      <p class="hint">Gmail change করা যাবে না।</p>

      <label class="fld-label">বর্তমান পাসওয়ার্ড</label>
      <input type="password" name="current_password" placeholder="বর্তমান পাসওয়ার্ড">
      <p class="hint">পাসওয়ার্ড পরিবর্তন করতে চাইলে বর্তমান পাসওয়ার্ড দিন।</p>

      <label class="fld-label">নতুন পাসওয়ার্ড</label>
      <input type="password" name="new_password" placeholder="নতুন পাসওয়ার্ড" minlength="6">

      <button type="submit" class="btn-indigo btn-block">SAVE SETTINGS</button>
    </form>

    <div class="back-link"><a href="/dashboard"><i class="fa-solid fa-arrow-left"></i> Back</a></div>
  </main>
  <%- include('partials/bottomnav', { nav: 'profile' }) %>
</div>
<%- include('partials/drawer', { user, settings, nav: 'profile' }) %>
<%- include('partials/flash') %>
<script src="/app.js"></script>
</body>
</html>

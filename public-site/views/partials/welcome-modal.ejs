<div class="modal-overlay" id="welcomeModal">
  <div class="modal-card">
    <button class="modal-close" id="welcomeCloseX" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
    <div class="welcome-icon"><i class="fa-solid fa-circle-info"></i></div>
    <h2 class="welcome-title">Welcome!</h2>
    <p class="welcome-text">প্রতিদিন গিফট কোড দেওয়া হয় আমাদের টেলিগ্রাম চ্যানেলে। গিফট কোড বোনাস নিতে জয়েন করুন</p>
    <a href="<%= settings.telegram_link %>" target="_blank" rel="noopener" class="btn-teal"><i class="fa-brands fa-telegram"></i> Join Telegram</a>
    <hr class="welcome-hr">
    <p class="welcome-warn">যাদের ট্রানজেকশন সমস্যা তারা নিচের আইডিতে যোগাযোগ করবেন</p>
    <div class="admin-btns">
      <a href="<%= settings.admin1_link %>" target="_blank" rel="noopener"><i class="fa-solid fa-user-tie"></i> <%= settings.admin1_name %></a>
      <a href="<%= settings.admin2_link %>" target="_blank" rel="noopener"><i class="fa-solid fa-user-tie"></i> <%= settings.admin2_name %></a>
    </div>
  </div>
</div>
<form method="post" action="/welcome/close" id="welcomeCloseForm" style="display:none"></form>
<script>
  (function () {
    function closeModal() {
      const f = document.getElementById('welcomeCloseForm');
      if (f) f.submit();
    }
    const m = document.getElementById('welcomeModal');
    const x = document.getElementById('welcomeCloseX');
    if (x) x.addEventListener('click', closeModal);
    if (m) m.addEventListener('click', e => { if (e.target === m) closeModal(); });
  })();
</script>

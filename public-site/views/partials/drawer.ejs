<div class="drawer-overlay" id="drawerOverlay"></div>
<aside class="drawer" id="drawer">
  <div class="drawer-head">
    <div class="drawer-brand"><i class="fa-solid fa-bolt"></i> BD TOP EARN</div>
    <button class="icon-btn drawer-close" id="drawerClose" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
  </div>
  <div class="drawer-profile">
    <div class="avatar-ring"><i class="fa-solid fa-user-tie"></i></div>
    <div class="drawer-name"><%= user.full_name %></div>
    <div class="drawer-idline">
      <span class="id-pill">ID: <%= user.ref_code %></span>
      <span class="status-pill <%= user.is_active ? 'active' : 'inactive' %>"><span class="dot"></span> <%= user.is_active ? 'Active' : 'Inactive' %></span>
    </div>
    <div class="drawer-stats">
      <div class="ds"><span>BALANCE</span><b>৳ <%= Number(user.balance).toFixed(2) %></b></div>
      <div class="ds"><span>MEMBER SINCE</span><b><%= new Date(user.created_at + 'Z').toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }) %></b></div>
    </div>
    <div class="drawer-actions">
      <a href="/profile" class="btn-mini btn-indigo"><i class="fa-solid fa-user-gear"></i> Profile</a>
      <a href="/help" class="btn-mini btn-rose"><i class="fa-solid fa-headset"></i> Support</a>
    </div>
  </div>
  <nav class="drawer-nav">
    <div class="dnav-label">HOME SELECTION</div>
    <a href="/dashboard" class="dnav-item <%= nav === 'home' ? 'on' : '' %>"><i class="fa-solid fa-house" style="color:#3b82f6"></i> Dashboard</a>
    <a href="/profile" class="dnav-item <%= nav === 'profile' ? 'on' : '' %>"><i class="fa-solid fa-user-gear" style="color:#8b5cf6"></i> Profile Update</a>
    <div class="dnav-label">FINANCE</div>
    <a href="/wallet" class="dnav-item <%= nav === 'wallet' ? 'on' : '' %>"><i class="fa-solid fa-money-bill-transfer" style="color:#10b981"></i> Withdraw Funds</a>
    <a href="/history" class="dnav-item <%= nav === 'history' ? 'on' : '' %>"><i class="fa-solid fa-clock-rotate-left" style="color:#6366f1"></i> Payment History</a>
    <div class="dnav-label">TEAM &amp; SUPPORT</div>
    <a href="/team" class="dnav-item <%= nav === 'team' ? 'on' : '' %>"><i class="fa-solid fa-users" style="color:#0ea5e9"></i> My Team</a>
    <a href="/help" class="dnav-item <%= nav === 'help' ? 'on' : '' %>"><i class="fa-solid fa-headset" style="color:#f97316"></i> Helpline</a>
    <div class="dnav-label">ACCOUNT</div>
    <form method="post" action="/logout" class="dnav-form">
      <button type="submit" class="dnav-item dnav-logout"><i class="fa-solid fa-right-from-bracket"></i> Log Out</button>
    </form>
  </nav>
</aside>

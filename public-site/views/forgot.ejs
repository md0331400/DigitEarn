<%- include('partials/head', { title: 'Forgot Password' }) %>
<div class="phone">
  <div class="auth-wrap" style="padding-top:48px">
    <div class="tab-switch" style="pointer-events:none">
      <a href="/login" class="active">Log In</a>
      <a href="/register">Sign Up</a>
    </div>
    <div class="auth-card">
      <h1 class="auth-title">Forgot Password</h1>
      <p class="auth-sub">পাসওয়ার্ড রিসেট করতে আমাদের সাথে যোগাযোগ করুন</p>
      <form method="post" action="/forgot" class="auth-form">
        <div class="field">
          <i class="fa-solid fa-envelope left"></i>
          <input type="email" name="email" placeholder="আপনার অ্যাকাউন্টের ইমেইল" value="<%= email %>" required>
        </div>
        <button type="submit" class="btn-blue">চেক করুন</button>
      </form>
      <% if (done) { %>
        <% if (exists) { %>
          <div class="ok-box" style="margin-top:14px"><i class="fa-solid fa-circle-info"></i> এই ইমেইলটি আমাদের ডাটাবেজে আছে। পাসওয়ার্ড রিসেট করতে নিচের এডমিনের সাথে যোগাযোগ করুন।</div>
        <% } else { %>
          <div class="error-box" style="margin-top:14px"><i class="fa-solid fa-circle-info"></i> এই ইমেইলে কোনো অ্যাকাউন্ট খুঁজে পাওয়া যায়নি।</div>
        <% } %>
        <div class="admin-btns" style="margin-top:12px">
          <a href="<%= settings.admin1_link %>" target="_blank" rel="noopener"><i class="fa-solid fa-user-tie"></i> <%= settings.admin1_name %></a>
          <a href="<%= settings.admin2_link %>" target="_blank" rel="noopener"><i class="fa-solid fa-user-tie"></i> <%= settings.admin2_name %></a>
        </div>
      <% } %>
      <div class="back-link" style="margin-top:16px"><a href="/login"><i class="fa-solid fa-arrow-left"></i> Login পেজে ফিরে যান</a></div>
    </div>
  </div>
</div>
<script src="/app.js"></script>
</body>
</html>

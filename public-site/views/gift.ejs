<%- include('partials/head', { title: 'Gift Code' }) %>
<div class="phone">
  <%- include('partials/header', { user, settings }) %>
  <main class="main">
    <div class="page-back"><a href="/dashboard"><i class="fa-solid fa-arrow-left"></i> Dashboard</a></div>

    <div class="card gift-hero" style="text-align:center">
      <div class="task-ico" style="color:#ec4899;background:#ec48991a;width:64px;height:64px;font-size:26px;margin:0 auto 10px"><i class="fa-solid fa-gift"></i></div>
      <h2 class="task-name">ডেইলি গিফট কোড</h2>
      <p class="muted">প্রতিদিন আমাদের টেলিগ্রাম চ্যানেলে একটি গিফট কোড দেওয়া হয়। কোডটি দিয়ে ৳<%= settings.gift_reward %> বোনাস নিন।</p>
      <a href="<%= settings.telegram_link %>" target="_blank" rel="noopener" class="btn-teal" style="display:inline-flex;margin-top:6px"><i class="fa-brands fa-telegram"></i> কোড পেতে জয়েন করুন</a>
    </div>

    <div class="card">
      <h4 class="sec-title">কোড এন্ট্রি করুন</h4>
      <% if (claimedToday) { %>
        <div class="ok-box"><i class="fa-solid fa-circle-check"></i> আজকের গিফট বোনাস ইতিমধ্যে Claim করেছেন</div>
      <% } else { %>
        <form method="post" action="/gift/claim">
          <div class="field">
            <i class="fa-solid fa-ticket left"></i>
            <input type="text" name="code" placeholder="গিফট কোড লিখুন" required>
          </div>
          <button type="submit" class="btn-blue btn-block"><i class="fa-solid fa-gift"></i> Claim করুন</button>
        </form>
      <% } %>
    </div>
  </main>
  <%- include('partials/bottomnav', { nav: 'home' }) %>
</div>
<%- include('partials/drawer', { user, settings, nav: 'home' }) %>
<%- include('partials/flash') %>
<script src="/app.js"></script>
</body>
</html>

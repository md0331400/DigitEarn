<%- include('partials/head', { title: 'My Team' }) %>
<div class="phone">
  <%- include('partials/header', { user, settings }) %>
  <main class="main">
    <div class="card team-card">
      <div class="team-top">
        <div class="team-ico"><i class="fa-solid fa-users"></i></div>
        <div>
          <h2 class="team-title">My Referral Team</h2>
        </div>
        <div class="team-size"><span>Team Size:</span><b><%= counts.reduce((a, b) => a + b, 0) %></b></div>
      </div>
      <div class="ref-link-box">
        <input type="text" readonly value="<%= refLink %>" id="refLink">
        <button type="button" class="copy-btn" id="copyRef"><i class="fa-regular fa-copy"></i> Copy</button>
      </div>
    </div>

    <div class="card">
      <h4 class="sec-title">লেভেল অনুযায়ী টীম</h4>
      <% levelData.forEach(lv => { %>
        <div class="level-card">
          <div class="level-head">
            <b>Level <%= lv.level %> (<%= lv.count %>)</b>
            <button type="button" class="view-btn" data-target="lv<%= lv.level %>"><%= lv.count ? 'View' : 'View' %></button>
          </div>
          <div class="level-members" id="lv<%= lv.level %>" hidden>
            <% if (lv.members.length) { %>
              <% lv.members.forEach(m => { %>
                <div class="member">
                  <div class="m-avatar"><i class="fa-solid fa-user"></i></div>
                  <div class="m-info">
                    <b><%= m.full_name %></b>
                    <span>ID: <%= m.ref_code %> • <%= m.created_at.slice(0, 10) %></span>
                  </div>
                  <span class="m-status <%= m.is_active ? 'on' : 'off' %>"><%= m.is_active ? 'Active' : 'Inactive' %></span>
                </div>
              <% }); %>
            <% } else { %>
              <p class="muted center" style="padding:10px 0">এই লেভেলে কোনো সদস্য নেই</p>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>

    <div class="card">
      <h4 class="sec-title">রেফার করলে কী হয়?</h4>
      <ul class="perks">
        <li><i class="fa-solid fa-gift" style="color:#ec4899"></i> আপনার রেফারের জন্য নতুন সদস্য <b>৳<%= settings.register_bonus %></b> বোনাস পাবে</li>
        <li><i class="fa-solid fa-hand-holding-dollar" style="color:#10b981"></i> আপনি প্রতি রেফারে <b>৳<%= settings.referral_bonus %></b> বোনাস পাবেন</li>
        <li><i class="fa-solid fa-bullseye" style="color:#ef4444"></i> টার্গেট পূরণে বিশেষ বোনাস (৳৫০–৳৩০০)</li>
      </ul>
    </div>
  </main>
  <%- include('partials/bottomnav', { nav: 'team' }) %>
</div>
<%- include('partials/drawer', { user, settings, nav: 'team' }) %>
<%- include('partials/flash') %>
<script src="/app.js"></script>
</body>
</html>

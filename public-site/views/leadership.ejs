<%- include('partials/head', { title: 'Leadership' }) %>
<div class="phone">
  <%- include('partials/header', { user, settings }) %>
  <main class="main">
    <div class="page-back"><a href="/dashboard"><i class="fa-solid fa-arrow-left"></i> Dashboard</a></div>

    <div class="card lead-hero" style="text-align:center">
      <div class="task-ico" style="color:<%= current.color %>;background:<%= current.color %>1a;width:72px;height:72px;font-size:30px;margin:0 auto 10px"><i class="fa-solid <%= current.icon %>"></i></div>
      <h2 class="task-name" style="color:<%= current.color %>"><%= current.name %></h2>
      <p class="muted">মোট টীম: <b style="color:#0f172a"><%= total %></b> জন সদস্য</p>
      <% if (next) { %>
        <div class="lead-progress">
          <div class="tier-bar" style="width:<%= Math.min(100, Math.round(total / next.min * 100)) %>%"></div>
        </div>
        <p class="muted" style="font-size:13px">পরবর্তী লেভেল (<%= next.name %>) এর জন্য আরও <b><%= next.min - total %></b> জন রেফার করুন</p>
      <% } else { %>
        <div class="ok-box"><i class="fa-solid fa-trophy"></i> আপনি সর্বোচ্চ লেভেলে আছেন!</div>
      <% } %>
    </div>

    <div class="card">
      <h4 class="sec-title">আপনার টীম (লেভেল অনুযায়ী)</h4>
      <div class="level-rows">
        <% const names = ['লেভেল ১', 'লেভেল ২', 'লেভেল ৩', 'লেভেল ৪'];
           counts.forEach((c, i) => { %>
          <div class="level-row">
            <span><%= names[i] %></span>
            <b><%= c %> জন</b>
          </div>
        <% }); %>
      </div>
      <a href="/team" class="btn-blue btn-block" style="margin-top:12px"><i class="fa-solid fa-users"></i> পূর্ণ টীম দেখুন</a>
    </div>
  </main>
  <%- include('partials/bottomnav', { nav: 'home' }) %>
</div>
<%- include('partials/drawer', { user, settings, nav: 'home' }) %>
<%- include('partials/flash') %>
<script src="/app.js"></script>
</body>
</html>

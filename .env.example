# =====================================================================
# 1) Firebase WEB APP config (browser-এ চলে — VITE_ prefix থাকতেই হবে)
# Firebase Console → Project settings → Your apps → Web app → SDK setup
# Vercel-এ একই নামে Environment Variables (visibility: config, env: Production)
# =====================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# =====================================================================
# 2) Firebase ADMIN SDK config — ⚠️ SERVER-ONLY (Vercel function)
# কখনোই VITE_ prefix যোগ করবেন না — তাহলে browser-এ চলে যাবে
# কোথায় পাবেন: Firebase Console → Project settings → Service accounts
#   → "Generate new private key" → JSON-এ project_id / client_email / private_key
# private_key-এর মধ্যে \n (escaped newline) থাকলে ঠিক আছে — code handle করে
# =====================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

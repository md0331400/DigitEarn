rules_version = '2';
// DigitEarn — Firestore Security Rules
//
// নীতিমালা (owner-এর instruction):
//  • ওয়েবসাইট (browser) শুধু USER rule মেনে চলে — নিজের data পড়া, শুধু `name`
//    লেখা, আর public content (tasks / notices / settings/site)। admin-এর কিছুই
//    browser থেকে সরাসরি ছোঁা যায় না।
//  • Admin app (APK) Firestore ছুঁয় না — সব read/write যায়
//    POST https://digitearn.vercel.app/api/admin/panel?op=... দিয়ে
//    (Firebase ID token + admins/{email} doc + suspend check; server Admin SDK
//    দিয়ে লেখে, যেটা rules bypass করে)।
//  • ফলে: admin queue (proofs/deposits/withdrawals), admins/, accountKeys/,
//    settings/secret — browser থেকে চিরকাল 403, আর panel-এর কোনো ফিচার
//    "Missing or insufficient permissions." দিয়ে ভাঙে না।
//
// ⚠️ এই ফাইলটাই Firebase Console → Firestore → Rules → PUBLISH করুন।

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // ---------- public content: পড়া যাবে, লেখা যাবে না (লেখা শুধু server) ----------
    match /tasks/{taskId} {
      allow get, list: if true;
      allow write: if false;
    }
    match /notices/{noticeId} {
      allow get, list: if true;
      allow write: if false;
    }
    match /settings/site {
      allow get: if true;
      allow list, write: if false;
    }
    match /settings/{other} {
      allow read, write: if false;      // settings/secret সহ বাকি সব বন্ধ
    }
    match /refs/{code} {
      allow get: if true;
      allow list, write: if false;
    }

    // ---------- admin/সংবেদনশীল: client-এর জন্য সম্পূর্ণ বন্ধ ----------
    match /accountKeys/{key} { allow read, write: if false; }
    match /proofs/{proofId} { allow read, write: if false; }
    match /deposits/{depositId} { allow read, write: if false; }
    match /withdrawals/{wdId} { allow read, write: if false; }
    match /admins/{email} { allow read, write: if false; }
    match /adminJoins/{email} { allow read, write: if false; }

    // ---------- users ----------
    match /users/{userId} {
      function isSelf() { return signedIn() && request.auth.uid == userId; }
      // শুধু নাম — balance/totalEarned/isActive/refBy কখনো client থেকে না
      function safeProfileWrite() {
        return isSelf() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      }

      allow get: if isSelf();
      allow list, create, delete: if false;
      allow update: if safeProfileWrite();

      // নিজের subcollection (proofs/deposits/withdrawals/transactions/claims/notices)
      // — পড়া যাবে, লেখা যাবে না (সব server-এর API দিয়ে)
      match /{doc=**} {
        allow read: if isSelf();
        allow write: if false;
      }

      // রেফারেল টিম: signed-in user দেখতে পারে (multi-level count-এর জন্য দরকার),
      // লিখতে পারে না। balance/email/mobile এখানে কখনো রাখা হয় না।
      match /team/{childUid} {
        allow get, list: if signedIn();
        allow write: if false;
      }
    }
  }
}

rules_version = '2';
// DigitEarn — Firestore Security Rules
// Firebase Console → Firestore Database → Rules → এটা পুরোটা paste করে PUBLISH করুন
//
// কী রক্ষা করে:
//  - অন্য ইউজারের প্রোফাইল/ব্যালেন্স/ট্রানজেকশন কেউ পড়তে বা লিখতে পারবে না
//  - tasks / settings / notices শুধু পড়া যাবে (লাইভ সাইট থেকে পরিবর্তন সম্ভব না)
//  - ব্যালেন্স পরিবর্তন শুধু ২ রকম: (১) নিজের লিগিটিমেট claim/withdraw (২) রেফারেল বোনাস ক্রেডিট
//
// ⚠️ গুরুত্বপূর্ণ: ক্লায়েন্ট-সাইড অ্যাপে ব্যালেন্স পরিবর্তন সম্পূর্ণ নিরাপদ করা সম্ভব নয়।
// বড় স্কেলে real money ছাড়া Cloud Functions দিয়ে wallet লজিক তুলে আনতে হবে।
// নিচের সংখ্যাগুলা (5, 300) settings-এর bonus amount-এর সাথে মিলে রাখুন।

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- public content (সবাই পড়তে পারবে) ----------
    match /tasks/{taskId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /settings/{docId} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    match /notices/{noticeId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // ---------- refs/ — রেফারেল কোড → uid directory ----------
    // রেজিস্টার করার সময় কোড খোঁজা হয় এখান থেকে (users collection query করা হয় না)
    match /refs/{code} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow list, update, delete: if false;
    }

    // ---------- users ----------
    match /users/{userId} {
      function isSignedIn() { return request.auth != null; }
      function isSelf() { return request.auth.uid == userId; }

      // নিজের doc: শুধু নির্দিষ্ট ফিল্ডে পরিবর্তন, একবারে সর্বোচ্চ +৳৩০০ (সবচেয়ে বড় বোনাস)
      function selfWrite() {
        return isSignedIn() && isSelf() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['balance', 'totalEarned', 'welcomeShown', 'name', 'lastLogin', 'isActive', 'activationBonusGiven']
          ) &&
          request.resource.data.balance - resource.data.balance <= 300;
      }

      // অন্যের doc: শুধু রেফারেল বোনাস ক্রেডিট (+৳৫), নিজেকে বাদ
      function referralCredit() {
        return isSignedIn() && !isSelf() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'totalEarned']) &&
          request.resource.data.balance - resource.data.balance == 5;
      }

      allow get: if isSignedIn() && isSelf();
      allow create: if isSignedIn() && isSelf();
      allow update: if selfWrite() || referralCredit();
      allow list, delete: if false;

      // team — public referral tree (শুধু name/refCode/isActive — ব্যালেন্স নাই)
      match /team/{childUid} {
        allow get, list: if true;
        allow create: if isSignedIn() && childUid == request.auth.uid && request.resource.data.refBy == userId;
        allow update, delete: if false;
      }

      // বাকি private subcollections (transactions, taskClaims, giftClaims, targetClaims, withdrawals)
      match /{sub=**} {
        allow read, write: if isSignedIn() && isSelf();
        // রেজিস্ট্রেশনে নতুন মেম্বার referrer-এর transactions-এ referral_bonus entry লেখে
        allow create: if isSignedIn() &&
          request.resource.data.type == 'referral_bonus' &&
          request.resource.data.amount == 5 &&
          request.resource.data.refBy == userId &&
          request.resource.data.uid == request.auth.uid;
      }
    }
  }
}

<%- include('partials/head', { title: 'Admins' }) %>
<%- include('partials/sidebar', { active, sidebarOpen: false }) %>
<div class="content">
  <%- include('partials/topbar', { pageTitle: 'Admins' }) %>
  <div class="a-main">
    <div class="two-col">
      <div class="a-card">
        <div class="a-card-head"><h3><i class="fa-solid fa-user-shield" style="color:#0ea5e9"></i> বর্তমান এডমিন</h3></div>
        <% admins.forEach(a => { %>
          <div class="admin-row">
            <span class="admin-avatar"><i class="fa-solid fa-user"></i></span>
            <div class="admin-info">
              <b><%= a.name %></b>
              <small>@<%= a.username %> • যোগদান: <%= a.created_at.slice(0, 10) %></small>
            </div>
            <% if (admins.length > 1) { %>
              <form method="post" action="/admins/<%= a.id %>/delete" onsubmit="return confirm('এডমিন "@<%= a.username %>" মুছে ফেলবেন?')"><button type="submit" class="a-ico-btn danger" title="Delete"><i class="fa-solid fa-trash"></i></button></form>
            <% } %>
          </div>
        <% }); %>
      </div>

      <div class="a-card">
        <div class="a-card-head"><h3><i class="fa-solid fa-user-plus" style="color:#10b981"></i> নতুন এডমিন যোগ করুন</h3></div>
        <form method="post" action="/admins" class="a-form-grid">
          <div><label>নাম</label><input type="text" name="name" placeholder="যেমন: Abir" required></div>
          <div><label>ইউজারনেম</label><input type="text" name="username" pattern="[a-zA-Z0-9_.-]{3,30}" placeholder="a-z, 0-9 (৩–৩০ অক্ষর)" required></div>
          <div><label>পাসওয়ার্ড</label><input type="text" name="password" minlength="6" placeholder="কমপক্ষে ৬ অক্ষর" required></div>
          <div class="form-btn-row"><button type="submit" class="a-btn a-btn-primary"><i class="fa-solid fa-plus"></i> যোগ করুন</button></div>
        </form>

        <h4 class="sub-h">পাসওয়ার্ড রিসেট</h4>
        <% admins.forEach(a => { %>
          <form method="post" action="/admins/<%= a.id %>/reset-password" class="a-inline-form">
            <input type="text" name="password" minlength="6" placeholder="@<%= a.username %> এর নতুন পাসওয়ার্ড" required>
            <button type="submit" class="a-btn a-btn-sm a-btn-amber" onclick="return confirm('@<%= a.username %> এর পাসওয়ার্ড রিসেট করবেন?')">রিসেট</button>
          </form>
        <% }); %>
      </div>
    </div>
  </div>
</div>
<%- include('partials/flash') %>
<script src="/admin.js"></script>
</body>
</html>

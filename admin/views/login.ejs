<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin Login — DigitEarn</title>
<link rel="icon" href="/admin-logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/vendor/fa/css/all.min.css">
<link rel="stylesheet" href="/admin.css">
</head>
<body class="login-body">
  <div class="login-card">
    <div class="login-logo"><i class="fa-solid fa-bolt"></i></div>
    <h1>BD TOP EARN</h1>
    <p class="login-sub">Admin Control Panel</p>
    <% if (error) { %><div class="a-err"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div><% } %>
    <form method="post" action="/login">
      <div class="a-field">
        <i class="fa-solid fa-user"></i>
        <input type="text" name="username" placeholder="Username" required autofocus>
      </div>
      <div class="a-field">
        <i class="fa-solid fa-lock"></i>
        <input type="password" name="password" placeholder="Password" required>
      </div>
      <button type="submit" class="a-btn a-btn-primary a-btn-block"><i class="fa-solid fa-right-to-bracket"></i> Login to Panel</button>
    </form>
    <p class="login-note">শুধুমাত্র অনুমোদিত এডমিনদের জন্য। সাধারণ ইউজারদের জন্য আলাদা সাইট আছে।</p>
  </div>
</body>
</html>

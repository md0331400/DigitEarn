<aside class="sidebar <%= sidebarOpen ? 'open' : '' %>" id="sidebar">
  <div class="sb-brand">
    <span class="sb-logo"><i class="fa-solid fa-bolt"></i></span>
    <div>
      <b>BD TOP EARN</b>
      <small>Admin Panel</small>
    </div>
  </div>
  <nav class="sb-nav">
    <a href="/dashboard" class="sb-item <%= active === 'dashboard' ? 'on' : '' %>"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
    <a href="/users" class="sb-item <%= active === 'users' ? 'on' : '' %>"><i class="fa-solid fa-users"></i> Users</a>
    <a href="/tasks" class="sb-item <%= active === 'tasks' ? 'on' : '' %>"><i class="fa-solid fa-briefcase"></i> Projects / Tasks</a>
    <a href="/withdrawals" class="sb-item <%= active === 'withdrawals' ? 'on' : '' %>"><i class="fa-solid fa-money-bill-transfer"></i> Withdrawals</a>
    <a href="/transactions" class="sb-item <%= active === 'transactions' ? 'on' : '' %>"><i class="fa-solid fa-right-left"></i> Transactions</a>
    <a href="/notices" class="sb-item <%= active === 'notices' ? 'on' : '' %>"><i class="fa-solid fa-bullhorn"></i> Notices</a>
    <a href="/settings" class="sb-item <%= active === 'settings' ? 'on' : '' %>"><i class="fa-solid fa-gear"></i> Settings</a>
    <a href="/admins" class="sb-item <%= active === 'admins' ? 'on' : '' %>"><i class="fa-solid fa-user-shield"></i> Admins</a>
  </nav>
  <div class="sb-foot">
    <div class="sb-admin">
      <span class="sb-avatar"><i class="fa-solid fa-user"></i></span>
      <div>
        <b><%= admin.name %></b>
        <small>@<%= admin.username %></small>
      </div>
    </div>
    <a href="<%= siteUrl %>" target="_blank" rel="noopener" class="sb-site"><i class="fa-solid fa-globe"></i> View Site</a>
    <form method="post" action="/logout">
      <button type="submit" class="sb-logout"><i class="fa-solid fa-right-from-bracket"></i> Log Out</button>
    </form>
  </div>
</aside>
<div class="sb-overlay" id="sbOverlay"></div>

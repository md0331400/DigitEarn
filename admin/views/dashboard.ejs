<%- include('partials/head', { title: 'Dashboard' }) %>
<%- include('partials/sidebar', { active, sidebarOpen: false }) %>
<div class="content">
  <%- include('partials/topbar', { pageTitle: 'Dashboard' }) %>
  <div class="a-main">
    <div class="stat-grid">
      <div class="stat-card sc-blue">
        <span class="stat-ico"><i class="fa-solid fa-users"></i></span>
        <b><%= stats.all %></b>
        <small>মোট ইউজার</small>
      </div>
      <div class="stat-card sc-green">
        <span class="stat-ico"><i class="fa-solid fa-circle-check"></i></span>
        <b><%= stats.active %></b>
        <small>অ্যাক্টিভ ইউজার</small>
      </div>
      <div class="stat-card sc-purple">
        <span class="stat-ico"><i class="fa-solid fa-user-plus"></i></span>
        <b><%= stats.newToday %></b>
        <small>আজকের নিবন্ধন</small>
      </div>
      <div class="stat-card sc-amber">
        <span class="stat-ico"><i class="fa-solid fa-hourglass-half"></i></span>
        <b><%= stats.pendingCount %></b>
        <small>পেন্ডিং উইথড্র</small>
      </div>
      <div class="stat-card sc-rose">
        <span class="stat-ico"><i class="fa-solid fa-sack-dollar"></i></span>
        <b>৳<%= Number(stats.pendingAmount).toFixed(2) %></b>
        <small>পেন্ডিং টাকার পরিমাণ</small>
      </div>
      <div class="stat-card sc-teal">
        <span class="stat-ico"><i class="fa-solid fa-wallet"></i></span>
        <b>৳<%= Number(stats.totalBalance).toFixed(2) %></b>
        <small>ইউজারদের মোট ব্যালেন্স</small>
      </div>
    </div>

    <div class="two-col">
      <div class="a-card">
        <div class="a-card-head"><h3><i class="fa-solid fa-user-plus" style="color:#8b5cf6"></i> সর্বশেষ ইউজার</h3><a href="/users" class="a-link">সব দেখুন</a></div>
        <div class="a-table-wrap">
          <table class="a-table">
            <thead><tr><th>ID</th><th>নাম</th><th>মোবাইল</th><th>ব্যালেন্স</th><th>স্ট্যাটাস</th></tr></thead>
            <tbody>
              <% recentUsers.forEach(u => { %>
                <tr>
                  <td><a href="/users/<%= u.id %>" class="a-link">#<%= u.id %></a></td>
                  <td><b><%= u.full_name %></b></td>
                  <td><%= u.mobile %></td>
                  <td>৳<%= Number(u.balance).toFixed(2) %></td>
                  <td><span class="badge <%= u.is_active ? 'b-green' : 'b-red' %>"><%= u.is_active ? 'Active' : 'Inactive' %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="a-card">
        <div class="a-card-head"><h3><i class="fa-solid fa-money-bill-transfer" style="color:#f59e0b"></i> সর্বশেষ উইথড্র</h3><a href="/withdrawals" class="a-link">সব দেখুন</a></div>
        <div class="a-table-wrap">
          <table class="a-table">
            <thead><tr><th>#</th><th>ইউজার</th><th>টাকা</th><th>মেথড</th><th>স্ট্যাটাস</th></tr></thead>
            <tbody>
              <% recentWd.forEach(w => { %>
                <tr>
                  <td>#<%= w.id %></td>
                  <td><b><%= w.full_name || '—' %></b></td>
                  <td>৳<%= Number(w.amount).toFixed(2) %></td>
                  <td><%= w.method %></td>
                  <td><span class="badge <%= w.status === 'paid' ? 'b-green' : w.status === 'rejected' ? 'b-red' : 'b-amber' %>"><%= w.status %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/flash') %>
<script src="/admin.js"></script>
</body>
</html>

<%- include('partials/head', { title: isNew ? 'New Project' : 'Edit Project' }) %>
<%- include('partials/sidebar', { active, sidebarOpen: false }) %>
<div class="content">
  <%- include('partials/topbar', { pageTitle: isNew ? 'নতুন প্রজেক্ট' : 'প্রজেক্ট এডিট' }) %>
  <div class="a-main">
    <div class="back-line"><a href="/tasks" class="a-link"><i class="fa-solid fa-arrow-left"></i> প্রজেক্ট তালিকায় ফিরে যান</a></div>
    <form method="post" action="<%= isNew ? '/tasks' : '/tasks/' + task.id %>" class="a-card a-form-wide">
      <div class="a-form-grid two">
        <div>
          <label>প্রজেক্টের নাম (বাংলা) *</label>
          <input type="text" name="name_bn" value="<%= task.name_bn %>" required placeholder="যেমন: ফেসবুক সেল">
        </div>
        <div>
          <label>ক্রম (sort) — ছোট সংখ্যা আগে দেখাবে</label>
          <input type="number" name="sort" value="<%= task.sort %>">
        </div>
        <div>
          <label>ধরন</label>
          <select name="kind" id="kindSel">
            <option value="task" <%= task.kind === 'task' ? 'selected' : '' %>>Task (লিংক + রিওয়ার্ড)</option>
            <option value="page" <%= task.kind === 'page' ? 'selected' : '' %>>Internal Page (সাইটের ভেতরের প্যেজ)</option>
          </select>
        </div>
        <div>
          <label>আইকন</label>
          <select name="icon">
            <% iconOptions.forEach(([cls, label]) => { %>
              <option value="<%= cls %>" <%= task.icon === cls ? 'selected' : '' %>><%= label %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label>আইকনের রং</label>
          <input type="color" name="color" value="<%= task.color %>" class="color-input">
        </div>
        <div id="pageWrap" class="<%= task.kind === 'page' ? '' : 'hidden' %>">
          <label>কোন প্যেজে যাবে?</label>
          <select name="page">
            <option value="team">/team — রেফারেল টীম</option>
            <option value="gift">/gift — গিফট কোড</option>
            <option value="target">/target — টার্গেট বোনাস</option>
            <option value="leadership">/leadership — লিডারশিপ</option>
          </select>
          <% if (task.page) { %>
            <script>document.addEventListener('DOMContentLoaded', () => { const s = document.querySelector('[name=page]'); if (s && '<%= task.page %>') s.value = '<%= task.page %>'; });</script>
          <% } %>
        </div>
        <div id="urlWrap" class="<%= task.kind === 'task' ? '' : 'hidden' %>">
          <label>কাজের লিংক (URL) *</label>
          <input type="url" name="url" value="<%= task.url || '' %>" placeholder="https://...">
        </div>
        <div id="rewardWrap" class="<%= task.kind === 'task' ? '' : 'hidden' %>">
          <label>রিওয়ার্ড (৳) — প্রতিদিন একবার</label>
          <input type="number" step="0.01" min="0" name="reward" value="<%= task.reward %>">
        </div>
        <div class="full">
          <label>কাজের ধাপসমূহ (প্রতি লাইনে একটি ধাপ)</label>
          <textarea name="steps" rows="4" placeholder="ধাপ ১&#10;ধাপ ২&#10;ধাপ ৩"><%= task.stepsText || '' %></textarea>
        </div>
        <div class="full check-row">
          <label class="chk"><input type="checkbox" name="locked" <%= task.locked ? 'checked' : '' %>> <i class="fa-solid fa-lock"></i> প্রজেক্ট লক করুন (টিক থাকলে লক আইকন দেখাবে ও কাজ করা যাবে না)</label>
          <label class="chk"><input type="checkbox" name="enabled" <%= task.enabled ? 'checked' : '' %>> <i class="fa-solid fa-eye"></i> সাইটে দেখান</label>
        </div>
      </div>
      <div class="form-btn-row two-btns">
        <button type="submit" class="a-btn a-btn-primary"><i class="fa-solid fa-floppy-disk"></i> <%= isNew ? 'যোগ করুন' : 'আপডেট করুন' %></button>
        <a href="/tasks" class="a-btn a-btn-ghost">বাতিল</a>
      </div>
    </form>
  </div>
</div>
<script>
  const kindSel = document.getElementById('kindSel');
  if (kindSel) {
    const setWrap = () => {
      const isPage = kindSel.value === 'page';
      document.getElementById('pageWrap').classList.toggle('hidden', !isPage);
      const tw = document.getElementById('urlWrap'), rw = document.getElementById('rewardWrap');
      tw.classList.toggle('hidden', isPage); rw.classList.toggle('hidden', isPage);
    };
    kindSel.addEventListener('change', setWrap);
  }
</script>
<%- include('partials/flash') %>
<script src="/admin.js"></script>
</body>
</html>

<%- include('partials/head', { title: 'Withdrawals' }) %>
<%- include('partials/sidebar', { active, sidebarOpen: false }) %>
<div class="content">
  <%- include('partials/topbar', { pageTitle: 'Withdrawals' }) %>
  <div class="a-main">
    <div class="a-card">
      <div class="a-tabs">
        <a href="/withdrawals?status=pending" class="a-tab <%= status === 'pending' ? 'on' : '' %>">পেন্ডিং</a>
        <a href="/withdrawals?status=paid" class="a-tab <%= status === 'paid' ? 'on' : '' %>">পেড</a>
        <a href="/withdrawals?status=rejected" class="a-tab <%= status === 'rejected' ? 'on' : '' %>">বাতিল</a>
        <a href="/withdrawals?status=all" class="a-tab <%= status === 'all' ? 'on' : '' %>">সব</a>
        <span class="a-count" style="margin-left:auto">মোট পেন্ডিং: <b class="amber">৳<%= Number(pendingSum).toFixed(2) %></b></span>
      </div>
      <div class="a-table-wrap">
        <table class="a-table">
          <thead><tr><th>#</th><th>ইউজার</th><th>টাকা</th><th>মেথড</th><th>একাউন্ট নম্বর</th><th>তারিখ</th><th>স্ট্যাটাস</th><th>অ্যাকশন</th></tr></thead>
          <tbody>
            <% if (!rows.length) { %>
              <tr><td colspan="8" class="a-empty"><i class="fa-solid fa-inbox"></i> এই ক্যাটাগরিতে কোনো রিকোয়েস্ট নেই</td></tr>
            <% } %>
            <% rows.forEach(w => { %>
              <tr>
                <td>#<%= w.id %></td>
                <td><a href="/users/<%= w.user_id %>" class="a-link"><b><%= w.full_name || 'ID ' + w.user_id %></b></a><br><small class="dim"><%= w.email || '—' %></small></td>
                <td><b>৳<%= Number(w.amount).toFixed(2) %></b></td>
                <td><span class="badge b-blue"><%= w.method %></span></td>
                <td><%= w.account_number %></td>
                <td><small><%= w.created_at.replace('T', ' ').slice(0, 16) %> UTC</small></td>
                <td>
                  <span class="badge <%= w.status === 'paid' ? 'b-green' : w.status === 'rejected' ? 'b-red' : 'b-amber' %>"><%= w.status %></span>
                  <% if (w.note) { %><br><small class="dim"><%= w.note %></small><% } %>
                </td>
                <td>
                  <% if (w.status === 'pending') { %>
                    <div class="wd-actions">
                      <form method="post" action="/withdrawals/<%= w.id %>/approve">
                        <input type="text" name="note" placeholder="নোট (optional)" class="wd-note">
                        <button type="submit" class="a-btn a-btn-sm a-btn-green" onclick="return confirm('৳<%= w.amount %> পেমেন্ট কনফার্ম করবেন?')"><i class="fa-solid fa-check"></i> Paid</button>
                      </form>
                      <form method="post" action="/withdrawals/<%= w.id %>/reject">
                        <input type="text" name="note" placeholder="কারণ" class="wd-note">
                        <button type="submit" class="a-btn a-btn-sm a-btn-rose" onclick="return confirm('রিকোয়েস্ট বাতিল করলে টাকা ইউজারের ব্যালেন্সে ফেরত যাবে। নিশ্চিত?')"><i class="fa-solid fa-xmark"></i> Reject</button>
                      </form>
                    </div>
                  <% } else { %>
                    <span class="dim"><small><%= w.processed_at ? w.processed_at.replace('T', ' ').slice(0, 16) + ' UTC' : '' %></small></span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('partials/flash') %>
<script src="/admin.js"></script>
</body>
</html>

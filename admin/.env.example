# ===== Admin panel — LOCAL development (.env.local file-এ copy করে use করুন) =====
# কপি:  cp .env.example .env.local   তারপর নিচের 6টা value বসান
# .env.local git-এ জমা হয় না (.gitignore-ড) — safe

# Firebase Web App config (Firebase Console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ⚠️ FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY এখানে দিবেন না
# এগুলো শুধু Vercel-এর Environment Variables-এ (server-only, browser-এ আসে না)
# Local-এ approve/reject button কাজ করবে না — সেগুলো Vercel-এ host করলেই চলবে
